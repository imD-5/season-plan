# Copy to .env and fill in. .env is git-ignored.

# TypeSafe AI key for Jev task sorting. Without it, new tasks go to "other".
TYPESAFE_API_KEY=

# Optional: a sentence describing you, used by Jev when sorting tasks.
# SEASON_CONTEXT=master's student in Tokyo, finishing a thesis, job hunting in Germany

# Optional overrides (defaults shown)
# TYPESAFE_DEFAULT_MODEL=jev-latest
# SEASON_MIN_PROBABILITY=0.5
# SEASON_PORT=8765
# SEASON_DB=./season.db

# Optional: open the board on your phone through Tailscale (see README, "On your iPhone").
# The HTTPS address `tailscale serve` prints, so writes from it are allowed.
# SEASON_ALLOWED_ORIGINS=https://your-mac.your-tailnet.ts.net
